// Prisma schema for Property Deal Analyzer.
//
// MVP uses SQLite (DATABASE_URL="file:./dev.db") so the app runs with zero
// external services. Every model that holds user data carries a `userId`
// foreign key so switching the datasource to Postgres/Supabase later is a
// one-line config change, not a data-model rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  deals              Deal[]
  lenders            Lender[]
  leads              Lead[]
  contacts           Contact[]
  markets            Market[]
  groups             Group[]
  posts              Post[]
  legalCases         LegalCase[]
  generatedDocuments GeneratedDocument[]
  courseRules        CourseRule[]
  companySettings    CompanySettings?
  companyObjectives  CompanyObjective[]
}

// SQLite has no native enum support in Prisma, so DealStage/LeadStatus are plain strings
// constrained by zod at the API boundary. `stage` widened for the Acquisition OS pipeline
// (Master Build Prompt section 18) -- see src/lib/types/deal.ts DEAL_STAGES for the full,
// ordered list. The original five values (ANALYZING | OFFER | UNDER_CONTRACT | CLOSED | DEAD)
// remain valid and are what every existing seeded/created deal already uses.
model Deal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isDemo Boolean @default(false)
  stage  String  @default("ANALYZING")

  // Identity / entry (spec section 4)
  address      String
  city         String?
  state        String?
  zip          String?
  askingPrice  Float?
  propertyType String?
  units        Int     @default(1)
  bedrooms     Int?
  bathrooms    Float?
  sqft         Int?

  // Each of these holds a typed JSON blob (see src/lib/types/deal.ts), serialized to a
  // String because Prisma's SQLite connector has no native Json type. src/lib/jsonFields.ts
  // handles the serialize/deserialize boundary everywhere these are read or written --
  // switching the datasource to Postgres later can drop that layer and use Json directly.
  property        String? // condition, ages of systems, occupancy, taxes, etc.
  seller          String? // seller motivation / CRM-lite fields for this deal
  valueArv        String? // as-is value, ARV bands, comps, confidence
  rehab           String? // line items with low/expected/high + contingency
  rent            String? // market rent + Section 8 analysis
  financing       String? // hard money assumptions + refinance assumptions
  creativeFinance String? // seller-finance / subject-to analysis
  assumptions     String? // investor requirements used by acquisition price engine
  dealKillers     String? // array of flags {key, status, note}

  // ACQUISITION OS: source-of-deal linkage and wholesaler math (Master Build Prompt
  // sections 1-2, 8). sourceContactId is nullable and onDelete: SetNull -- deleting a
  // contact must never delete the property record it sourced.
  sourceContactId String?
  sourceContact   Contact? @relation(fields: [sourceContactId], references: [id], onDelete: SetNull)
  // Valid values: DIRECT_SELLER | REALTOR | WHOLESALER | REFERRAL | INVESTOR | UNKNOWN.
  sourceType      String?

  // Wholesaler-specific (spec section 8): total acquisition before other transaction costs
  // is always contractPrice + assignmentFee, computed and displayed explicitly -- never
  // folded into a single opaque number. See src/lib/calc/acquisitionTotal.ts.
  contractPrice Float?
  assignmentFee Float?

  // Deal-structuring authority gate (Master Build Prompt "Master Deal Structuring Engine"):
  // a wholesaler's assignment never grants authority to offer seller financing, subject-to,
  // a wrap, or a lease option. These three facts are what src/lib/strategy/
  // strategyAvailability.ts checks before ever showing a seller-cooperation structure as
  // available. All tri-state ("YES" | "NO" | null-meaning-unknown) -- unknown is never
  // silently treated as yes.
  assignmentPermitted        Boolean?
  sellerApprovalForTerms     String?
  wholesalerControlsContract String?

  // Follow-Up Command Center (spec section 14). Additive alongside the existing `stage`
  // field -- widening stage's own valid-value set is documented above; these three answer
  // "whose turn is it" separately from "what stage is the deal in."
  nextAction        String?
  // Valid values: INVESTOR | SELLER | AGENT | WHOLESALER | LENDER | CONTRACTOR | ATTORNEY |
  // SUPPORT | WAITING.
  nextActionOwner   String?
  // Valid values: CALL | TEXT | FACEBOOK_DM | EMAIL | SUPPORT_CALL | WAIT.
  nextContactMethod String?
  // Valid values: TODAY | ONE_TWO_DAYS | ONE_WEEK | ONE_TWO_WEEKS | THIRTY_DAYS | CUSTOM | NONE.
  followUpCadence   String?

  notes     Note[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category  String // seller | property | contractor | lender | general
  text      String
  source    String   @default("manual") // manual | voice
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name      String
  url       String
  kind      String // photo | screenshot | document
  createdAt DateTime @default(now())
}

model Lender {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  contact   String?
  email     String?
  phone     String?
  website   String?
  geography String?
  loanType  String? // hard_money | dscr | conventional | other
  terms     String // JSON-serialized HardMoneyTerms (rate, points, ltcCap, arvLtvCap, fees, etc.)
  verified  Boolean   @default(false)
  quoteDate DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Valid LeadStatus values: NEW | TALKING | QUALIFIED | CALL_SCHEDULED | ANALYZING | OFFER |
// FOLLOW_UP | UNDER_CONTRACT | CLOSED | DEAD (see src/app/api/leads for the zod boundary).
model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sellerName String
  address    String?
  phone      String?
  email      String?
  status     String  @default("NEW")
  motivation String? // JSON-serialized observable motivation signals (spec section 28)
  details    String? // JSON-serialized reason for selling, timeline, debts, cash need, etc.
  notes      String?

  // Facebook/community inbound lead-gen linkage (loose references, not Prisma relations,
  // so a deleted market/group/post never blocks deleting a lead that came from it).
  marketId     String?
  groupId      String?
  sourcePostId String?
  dealId       String? // set once "Create Deal Analysis" hands this lead off to underwriting

  // Seller qualification, structured around the 10 core questions (spec: "Seller
  // Conversation Engine / 10 Magic Questions System"). JSON array of QualificationAnswer
  // (see src/lib/types/leadgen.ts).
  qualification String?

  // Question ids (1-10) the investor chose to skip for now -- excluded from "next best
  // question" until answered or revisited. JSON number[].
  skippedQuestions String?

  // The 21-item pre-signing verification checklist (spec: "MAJOR SYSTEM GATE. DO NOT SIGN
  // YET.") shown once the seller responds OPEN_TO_TERMS/MAYBE. JSON VerificationChecklistItem[].
  verificationChecklist String?

  // Transparent priority signal -- STRONG | MODERATE | UNCLEAR -- plus the observable
  // reasons that produced it (never an unexplained AI score).
  priorityLevel   String?
  priorityReasons String? // JSON string[]

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?

  // AR Residential Operating System (Company Command Center): the same "whose turn is it"
  // fields already added to Deal (see above), mirrored here so a Lead can appear in the
  // Chief of Staff's daily plan exactly like a Deal does. Reuses Deal's existing
  // NextActionOwner/NextContactMethod/FollowUpCadence value sets from src/lib/types/deal.ts
  // -- do not redefine a second enum for the same concept.
  nextAction        String?
  nextActionOwner   String?
  nextContactMethod String?
  followUpCadence   String?
  // Valid values: DIRECT_SELLER | REALTOR | WHOLESALER | REFERRAL | UNKNOWN (src/lib/types/lead.ts
  // LeadType). Lets Acquisitions routing skip homeowner-motivation questions for a wholesaler
  // who does not own the property -- separate from Deal/Contact's SourceType/ContactRole
  // since Lead remains its own model.
  leadType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  notes String?

  groups Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Valid Group.priority values: HIGH_PRIORITY | TEST | LOW_PRIORITY | STOP_USING.
// Valid Group.groupType values: community | neighborhood | buy_sell_trade | landlord |
// property_owner | real_estate | investor | vacation_rental | local_business | other.
model Group {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  name               String
  url                String?
  groupType          String    @default("community")
  memberCount        Int?
  activityLevel      String? // HIGH | MEDIUM | LOW
  sellerPotential    String? // HIGH | MEDIUM | LOW
  investorSaturation String? // HIGH | MEDIUM | LOW
  postingRules       String?
  promotionAllowed   Boolean?
  realEstateAllowed  Boolean?
  dateJoined         DateTime?
  approvalDate       DateTime? // some groups require admin approval before you can post at all
  lastPostDate       DateTime?
  lastEngagementDate DateTime?
  priority           String    @default("TEST")
  notes              String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Valid Post.status values: DRAFT | POSTED | SKIPPED.
// Valid Post.responseOutcome values: NONE | COMMENT | DIRECT_MESSAGE | SELLER_LEAD.
// Valid Post.postType values: seasoning_community | looking_for_property | fixer_upper |
// small_multifamily | rental_property | tired_landlord | vacation_rental | general_seller |
// referral.
model Post {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  postType        String
  copy            String
  status          String    @default("DRAFT")
  postedAt        DateTime?
  responseOutcome String?
  leadId          String? // loose reference to the Lead this response became, if any

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ACQUISITION OS: unified CRM contact (Master Build Prompt section 1). One person can hold
// multiple roles (a wholesaler who also personally owns properties) -- never create a
// duplicate Contact for the same person because they sent another deal or wear another hat.
// `trade`/`category` predate this and are contractor-specific rating fields, kept optional
// and only meaningful when roles includes CONTRACTOR -- the existing Team page still reads
// and writes them exactly as before.
model Contact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  company String?
  phone   String?
  email   String?
  notes   String?

  // Contractor-specific (pre-existing, now optional since not every Contact is a contractor).
  trade    String? // general_contractor | plumbing | electrical | ...
  category String? // PREFERRED | BACKUP | DO_NOT_USE

  // JSON array of ContactRole (src/lib/types/contact.ts) -- SELLER | REALTOR | WHOLESALER |
  // INVESTOR | REFERRAL | LENDER | CONTRACTOR | PROPERTY_MANAGER | ATTORNEY | UNKNOWN.
  roles String @default("[]")

  market                 String?
  leadSource             String?
  relationshipStatus     String? // e.g. ACTIVE | COLD | DO_NOT_CONTACT
  preferredContactMethod String? // CALL | TEXT | FACEBOOK_DM | EMAIL
  lastContactAt          DateTime?
  nextFollowUpAt         DateTime?

  // Properties/opportunities this contact sourced, owns, or is otherwise tied to.
  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SMART CONTRACT BUILDER -- New York creative-finance legal workflow.
//
// Non-negotiable: nothing here represents production-ready legal language.
// Every TemplateVersion carries its own attorneyReviewStatus; UI must never
// present DRAFT_NOT_REVIEWED content as attorney-approved. Jurisdiction and
// LegalRule form a real registry (not switch-statement logic) so additional
// states/counties can be added later without touching trigger code.
// ============================================================

model Jurisdiction {
  id           String  @id @default(cuid())
  state        String // e.g. "NY"
  county       String? // e.g. "Monroe"
  municipality String? // e.g. "Rochester"
  notes        String?

  sources    LegalSource[]
  rules      LegalRule[]
  legalCases LegalCase[]

  createdAt DateTime @default(now())

  @@unique([state, county, municipality])
}

model LegalSource {
  id             String       @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  statuteRef       String // e.g. "NY RPL 265-a" -- a reference, never the statute's actual text
  title            String
  sourceUrl        String?
  effectiveDate    DateTime?
  lastVerifiedDate DateTime?
  notes            String? // e.g. "Exact statutory thresholds pending NY counsel verification"

  rules LegalRule[]

  createdAt DateTime @default(now())
}

// Valid LegalRule.status values: DRAFT | ACTIVE | OUTDATED. A rule describes WHEN a
// requirement applies and WHAT is required in structured fields -- it never stores
// AI-paraphrased statutory text. Versioned: a changed rule is a new row, old ones kept
// for audit (never mutate ruleSummary/requiredX fields on an ACTIVE rule in place).
model LegalRule {
  id             String       @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  sourceId       String?
  source         LegalSource? @relation(fields: [sourceId], references: [id])

  transactionType        String? // null = applies to all transaction types
  propertyType           String?
  occupancyApplicability String? // e.g. "owner_occupied_1_to_4_family"
  distressApplicability  String? // e.g. "default_or_foreclosure"

  ruleSummary               String
  requiredAction            String?
  requiredDisclosure        String?
  requiredDocument          String?
  requiredFormatting        String?
  requiredWaitingPeriodDays Int?
  attorneyReviewRequired    Boolean @default(true)

  status           String    @default("DRAFT")
  version          Int       @default(1)
  effectiveDate    DateTime?
  lastVerifiedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One legal case per deal (the "Legal Intake" instance). intake/triggerResult/
// requiredDocuments/attorneySummary are JSON (see src/lib/types/legal.ts) -- SQLite has no
// native Json type, so these follow the same String-column pattern as Deal/Lead JSON fields.
model LegalCase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealId String  @unique
  leadId String?

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  transactionType String // CASH | BRRRR | SELLER_FINANCE | SUBJECT_TO | HYBRID | WRAP | LEASE_OPTION | TRADITIONAL | OTHER

  intake            String? // LegalIntake JSON
  triggerResult     String? // LegalTriggerResult JSON (cached, recomputed on every intake save)
  requiredDocuments String? // DocumentRequirement[] JSON (cached)
  attorneySummary   String? // AttorneySummary JSON (cached)

  mortgageStatementReceived Boolean @default(false)

  // DRAFT | GATED | READY_FOR_DOCS | READY
  status String @default("DRAFT")

  documents        GeneratedDocument[]
  complianceEvents ComplianceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id              String  @id @default(cuid())
  key             String  @unique // e.g. "subject_to_disclosure"
  name            String
  description     String?
  transactionType String? // null = applies across transaction types

  versions TemplateVersion[]

  createdAt DateTime @default(now())
}

// Valid attorneyReviewStatus values: DRAFT_NOT_REVIEWED | ATTORNEY_REVIEW_PENDING |
// ATTORNEY_APPROVED | ATTORNEY_APPROVED_WITH_CONDITIONS | OUTDATED_RE_REVIEW_REQUIRED.
// A new version is ALWAYS a new row -- an approved version's body is never edited in
// place (spec: "do NOT silently update attorney-approved language").
model TemplateVersion {
  id         String           @id @default(cuid())
  templateId String
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version         Int
  bodyPlaceholder String // placeholder/skeleton text -- never production legal language until approved
  clauses         String? // TemplateClause[] JSON: [{ key, label, body, locked }]

  attorneyReviewStatus  String    @default("DRAFT_NOT_REVIEWED")
  attorneyName          String?
  attorneyStateAdmitted String?
  attorneyFirm          String?
  reviewDate            DateTime?
  restrictions          String?
  nextReviewDate        DateTime?
  notes                 String?

  generatedDocuments GeneratedDocument[]

  createdAt DateTime @default(now())

  @@unique([templateId, version])
}

// Once executedAt is set, a GeneratedDocument is immutable -- the API layer refuses any
// further field changes (spec: "Never overwrite an executed contract").
model GeneratedDocument {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalCaseId       String
  legalCase         LegalCase       @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])

  fieldsSnapshot String // JSON snapshot of the variable fields used to populate this document

  status     String    @default("DRAFT") // DRAFT | EXECUTED
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceEvent {
  id          String    @id @default(cuid())
  legalCaseId String
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)

  eventType String // e.g. "GATE_TRIGGERED" | "INTAKE_UPDATED" | "DOCUMENT_EXECUTED"
  detail    String

  createdAt DateTime @default(now())
}

// ============================================================
// AR RESIDENTIAL OPERATING SYSTEM -- Company Command Center (Phase 1).
//
// Non-negotiable: this layer aggregates and prioritizes data that already exists elsewhere
// (Deal, Lead, Group, Lender, LegalCase). It must never duplicate or reimplement the Deal
// Analyzer / Master Deal Structuring Engine / Strategy Router math -- those stay exactly as
// they are. See src/lib/ops/ for the pure functions that read this data.
// ============================================================

// Stores conflicting CFP course-source facts side by side instead of silently reconciling
// them (e.g. two documented versions of the Facebook "5/5/30" cadence). Multiple rows can
// share the same `key` -- that IS the conflict, preserved on purpose. Nothing here is ever
// treated as a numeric threshold the app enforces until a row is marked AUTHORITATIVE by a
// human with actual CFP clarification.
model CourseRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String // e.g. "FACEBOOK_5_5_30" | "FACEBOOK_BLUE_AD_WORDING"
  sourceLabel String // e.g. "CFP Facebook Tracker / Onboarding" | "Earlier Course Roadmap"
  ruleText    String // exact quoted wording, verbatim -- never paraphrased or "cleaned up"
  details     String? // JSON string[] of supporting bullet points, verbatim
  // NEEDS_CLARIFICATION (default -- multiple sources conflict) | AUTHORITATIVE | SUPERSEDED.
  status String @default("NEEDS_CLARIFICATION")

  createdAt DateTime @default(now())
}

// Singleton-per-user company financial facts. This is the ONLY source the CFO capital-position
// engine (src/lib/ops/cfoCapitalPosition.ts) reads for cash/reserve checks -- the app never
// estimates or invents these. Null/unset means NEEDS_INFO, not "assume it's fine."
model CompanySettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cashOnHand       Float?
  reserveMinimum   Float?
  committedCapital Float?

  updatedAt DateTime @updatedAt
}

// Weekly/monthly CEO-style objective lines (spec: "PRIMARY OBJECTIVE THIS WEEK" /
// "DO NOT PRIORITIZE"). Manually entered in Phase 1 -- the CEO engine reads these, it does
// not yet generate them.
model CompanyObjective {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  period      String // WEEK | MONTH
  periodLabel String // e.g. "2026-W38" or "2026-09"
  type        String // PRIMARY | SECONDARY | DO_NOT_PRIORITIZE
  text        String

  createdAt DateTime @default(now())
}
