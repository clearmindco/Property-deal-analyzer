# Database (MVP uses SQLite locally; swap DATABASE_URL to a Postgres/Supabase
# connection string in production without changing application code, since
# all data access goes through Prisma).
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI provider (optional). When unset, the app falls back to the built-in
# deterministic heuristic provider (lib/ai) so the product works with no
# external AI key. Set these to route AI Mentor / Deal Summary calls to a
# real model instead.
AI_PROVIDER="heuristic"
ANTHROPIC_API_KEY=""
